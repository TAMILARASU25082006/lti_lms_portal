# ==============================================================================
# COMPANY ACADEMY LMS - ENVIRONMENT VARIABLES CONFIGURATION
# ==============================================================================

# Application Base URL
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_ACADEMY_NAME="Company Academy"

# NextAuth Secret for JWT / Session Encryption (Generate with: openssl rand -base64 32)
NEXTAUTH_SECRET="change-this-to-a-secure-random-32-byte-secret"

# MongoDB Database Connection String
# Example: mongodb://localhost:27017/company_academy_lms OR mongodb+srv://<user>:<password>@cluster.mongodb.net/company_academy_lms
MONGODB_URI="mongodb://localhost:27017/company_academy_lms"

# Google OAuth 2.0 / OpenID Connect Credentials
# Obtain from Google Cloud Console (APIs & Services -> Credentials -> OAuth 2.0 Client IDs)
# Required Scopes: openid, email, profile
# Authorized JavaScript Origins: http://localhost:3000 (and your production domain)
# Authorized Redirect URIs: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Cloudinary Media Storage (Optional for external media / uploads)
# Obtain from Cloudinary Dashboard -> Programmable Media
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Optional Mock Auth Mode for Local Testing without live Google OAuth keys
# Set to "true" only in development if testing flows before Google Cloud credentials are wired.
ALLOW_DEV_IMPERSONATION="false"
